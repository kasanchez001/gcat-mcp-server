# Genesys Cloud region/domain examples:
# mypurecloud.com      = US East
# mypurecloud.com.au   = Australia/Sydney
# mypurecloud.ie       = Ireland/EU
GC_REGION=mypurecloud.com

# Genesys Cloud OAuth Client Credentials grant
GC_SERVICE_CLIENT_ID=
GC_SERVICE_CLIENT_SECRET=

# Optional. Safe default is 4 for customer-safe audits.
API_CONCURRENCY_LIMIT=4

# Optional data collection controls
EXPORT_PAGE_SIZE=100
EXPORT_MAX_PAGES=50
SNAPSHOT_ENABLED=true
SNAPSHOT_TTL_MS=21600000
